{
    "window.titleBarStyle": "custom",
    "extensions.ignoreRecommendations": true,
    "git.openRepositoryInParentFolders": "always",
    "editor.minimap.enabled": false,
    "editor.scrollbar.horizontalScrollbarSize": 0,
    "editor.scrollbar.verticalScrollbarSize": 12,
    "editor.folding": false,
    "editor.foldingHighlight": false,
    "editor.guides.indentation": false,
    "workbench.layoutControl.enabled": false,
    "window.commandCenter": false,
    "terminal.integrated.tabs.hideCondition": "never",
    "editor.bracketPairColorization.enabled": false,
    "terminal.integrated.commandsToSkipShell": [
        "-workbench.action.quickOpen",
        "workbench.action.debug.nextConsole",
    ],
    "editor.renderLineHighlight": "none",
    "git.confirmSync": false,
    "security.workspace.trust.untrustedFiles": "open",
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "explorer.excludeGitIgnore": true,
    "editor.autoClosingOvertype": "never",
    "editor.autoClosingDelete": "never",
    "editor.autoClosingQuotes": "never",
    "window.zoomLevel": 1,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "scm.diffDecorations": "none",
    "window.customTitleBarVisibility": "auto",
    "editor.cursorSurroundingLines": 12,
    "editor.acceptSuggestionOnCommitCharacter": true,
    "editor.acceptSuggestionOnEnter": "on",
    "editor.hover.enabled": "on",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestOnTriggerCharacters": false,
    "editor.wordBasedSuggestions": "off",
    "telemetry.telemetryLevel": "off",
    "rest-client.enableTelemetry": false,
    "editor.wordWrap": "on",
    "terminal.integrated.scrollback": 120015,
    "editor.fontSize": 14,
    "debug.console.fontSize": 14,
    "terminal.integrated.fontSize": 14,
    "chat.editor.fontSize": 14,
    "markdown.preview.fontSize": 14,
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "*.mutable": {
                "underline": false,
            }
        }
    },
    "explorer.confirmDelete": false,
    "editor.wrappingIndent": "none",
    "editor.renderWhitespace": "trailing",
    "files.simpleDialog.enable": true,
    "files.watcherExclude": {
        "**/__pycache__/**": true
    },
    "search.exclude": {
        "**/__pycache__/**": true
    },
    "accessibility.verbosity.terminal": false,
    "workbench.activityBar.location": "bottom",
    "editor.semanticHighlighting.enabled": false,
    "debug.onTaskErrors": "abort",
    "editor.stickyScroll.enabled": false,
    "explorer.confirmDragAndDrop": false,
    "rest-client.rememberCookiesForSubsequentRequests": false,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "dotnet.codeLens.enableReferencesCodeLens": false,
    "workbench.editor.editorActionsLocation": "titleBar",
    "files.exclude": {
        "**/.env/": true,
        "**/*.meta": true
    },
    "workbench.editor.wrapTabs": true,
    "window.density.editorTabHeight": "compact",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "workbench.editor.showTabs": "none",
    "explorer.confirmPasteNative": false,
    "editor.fontFamily": "Fira Code",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "editor.codeLensFontFamily": "Fira Code",
    "editor.inlayHints.fontFamily": "Fira Code",
    "editor.inlineSuggest.fontFamily": "Fira Code",
    "debug.console.fontFamily": "Fira Code",
    "scm.inputFontFamily": "Fira Code",
    "terminal.integrated.fontFamily": "Fira Code",
    "notebook.markup.fontFamily": "Fira Code",
    "notebook.output.fontFamily": "Fira Code",
    "chat.editor.fontFamily": "Fira Code",
    "chat.fontFamily": "Fira Code",
    "rest-client.fontFamily": "Fira Code",
    "editor.tabCompletion": "off",
    "editor.insertSpaces": false,
    "workbench.settings.showAISearchToggle": false,
    "chat.disableAIFeatures": true,
    "editor.cursorBlinking": "phase",
    "chat.extensionUnification.enabled": false,
    "accessibility.verbosity.comments": false,
    "update.showReleaseNotes": false,
    "editor.inlineSuggest.edits.allowCodeShifting": "never",
    "editor.inlayHints.enabled": "off",
    "chat.useAgentSkills": false,
    "editor.codeLens": false,
    "workbench.experimental.modernUI": false,
    "editor.autoClosingBrackets": "never",
    "editor.lineNumbers": "off",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "path": "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash"
        }
    },
    "terminal.integrated.initialHint": false,
    "security.workspace.trust.banner": "never",
    "workbench.colorTheme": "Visual Studio Dark",
    "workbench.colorCustomizations": {
        "editorCursor.foreground": "#ffff00",
        "terminalCursor.foreground": "#ffff00",
        "statusBar.background": "#000000",
        "statusBar.inactiveBackground": "#000000",
        "titleBar.activeBackground": "#000000",
        "titleBar.inactiveBackground": "#000000",
        "sideBar.background": "#151515",
    },
    "terminal.integrated.stickyScroll.enabled": false,
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
}